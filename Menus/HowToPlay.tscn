[node name="GardenHeading" type="Label" parent="Center/Card/Pad/Outer/Scroll/Content"]
layout_mode = 2
theme_type_variation = &"LabelHeading"
text = "The garden"

[node name="GardenText" type="Label" parent="Center/Card/Pad/Outer/Scroll/Content"]
layout_mode = 2
text = "Hedges can be cut by MNKI. Low stone walls and streams block MNKI, but Swan flies right over them. Wooden bridges let both friends cross. Bushes hide MNKI. Swan sees a wide area from above, including every teddy's view cone."
autowrap_mode = 3
custom_minimum_size = Vector2(700.0, 0.0)

[node name="TeddyHeading" type="Label" parent="Center/Card/Pad/Outer/Scroll/Content"]
layout_mode = 2
theme_type_variation = &"LabelHeading"
text = "The teddy guards"

[node name="TeddyText" type="Label" parent="Center/Card/Pad/Outer/Scroll/Content"]
layout_mode = 2
text = "Teddies never attack. If one catches MNKI, he is politely walked back to the gate. BUT a teddy that is chasing in a hurry will run straight over a trap and get hurt - and that ends the run. Break line of sight, hide, or disarm traps first. Teddies run FASTER than MNKI and call their friends, so you cannot outrun them: slip into a bush while they are still far away and they lose your trail. Sling teddies on watchtowers lob pebbles at Swan - the red target shows where a pebble will land, so keep moving to dodge. A hit only makes her dizzy."
autowrap_mode = 3
custom_minimum_size = Vector2(700.0, 0.0)

[node name="CloseButton" type="Button" parent="Center/Card/Pad/Outer"]
layout_mode = 2
custom_minimum_size = Vector2(320.0, 48.0)
text = "Got it"
unique_name_in_owner = true
